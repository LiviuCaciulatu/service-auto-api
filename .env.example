# Service API runtime configuration

# HTTP port for the Express server (default in code is 3000 if empty).
PORT=3000

# Generic authenticator base URL.
# Example: http://localhost:8080
AUTH_SERVICE_ENDPOINT=

# Shared client authorization code sent to the generic authenticator as X-Client-Code.
AUTH_SERVICE_AUTHORIZATION_CODE=

# Optional timeout in milliseconds for outbound calls to the generic authenticator.
AUTH_SERVICE_TIMEOUT_MS=5000

# PostgreSQL connection string used by src/db.ts.
# Example: postgresql://user:password@localhost:5432/service_auto
DATABASE_URL=

# AWS SDK region used by S3/Textract integrations.
# Example: eu-central-1
AWS_REGION=

# AWS access key used by the current AWS integration implementation.
AWS_ACCESS_KEY_ID=

# S3 bucket name used for uploaded files.
AWS_S3_BUCKET_NAME=

# AWS secret access key paired with AWS_ACCESS_KEY_ID.
AWS_SECRET_ACCESS_KEY=

# Optional / reserved for async Textract workflows (not currently read by the API runtime code).
AWS_TEXTRACT_SNS_TOPIC_ARN=

# Optional / reserved IAM role ARN for async Textract workflows.
AWS_TEXTRACT_ROLE_ARN=

# Deployment script configuration (used by ./auto-deploy.sh, not by the API process)

# AWS region where the target ECR repository exists.
AUTO_DEPLOYMENT_AWS_REGION=

# 12-digit AWS account ID that owns the ECR repository.
AUTO_DEPLOYMENT_AWS_ACCOUNT_ID=

# ECR repository name (without registry hostname).
# Example: service-auto-repository
AUTO_DEPLOYMENT_ECR_REPO=

# Docker image tag to push.
# Example: latest
AUTO_DEPLOYMENT_IMAGE_TAG=

# Comma-separated docker buildx platforms.
# Example: linux/amd64,linux/arm64
AUTO_DEPLOYMENT_PLATFORMS=

# Docker buildx builder name to create/use locally.
# Example: xbuilder
AUTO_DEPLOYMENT_BUILDER_NAME=
